{
code = "script khmr;
language dflt;


# ------------------ setup consonant cluster --------------------
sub uni17D2' uni179A' by k.17D2_179A.l1;

sub k.17D2_179A.l1 [uni1780 uni179A uni17A2]' by [uni1780.alt uni179A.alt uni17A2.alt];

# swap ra and e, ae, ai
sub uni17C1 k.17D2_179A.l1 by uni17C1.ra;
sub uni17C2 k.17D2_179A.l1 by uni17C2.ra;
sub uni17C3 k.17D2_179A.l1 by uni17C3.ra;
sub uni17C1.ra by k.17D2_179A.l1 uni17C1;
sub uni17C2.ra by k.17D2_179A.l1 uni17C2;
sub uni17C3.ra by k.17D2_179A.l1 uni17C3;



# ----- cluster for ri, rii, li, lii
lookup format_rili;


# ----- vannayutti work
lookup rewrite_bind_vannayutti;
lookup rewrite_release_vannayutti;

";
tag = ccmp;
},
{
